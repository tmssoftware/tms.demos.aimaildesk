  object mcpAssistant: TTMSMCPClient
    Left = 300
    Top = 200
    ClientName = 'GarageMailDesk dashboard'
    ClientVersion = '2.0'
    Servers = <>
    ToolCallTimeout = 200000
    ToolDeniedMessage = 
      'The user declined this action. Do not try it again; say what you' +
      ' would have done.'
    Tools = <
      item
        Name = 'filter_inbox'
        Description = 
          'Filter the inbox grid the user is looking at. Every parameter is' +
          ' optional; an omitted parameter clears that filter. Only set a f' +
          'ilter the user asked for: leave department out unless the user n' +
          'ames a department (a brand such as Audi is not a department; put' +
          ' it in text).'
        Parameters = <
          item
            ArrayProperties = <>
            Name = 'department'
            Type = ptEnum
            Required = False
            Description =
              'Department to show; omit it to show all departments. Only when' +
              ' the user names a department.'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'priority'
            Type = ptEnum
            Required = False
            Description = 'Priority to show'
            Properties = <>
          end
          item
            ArrayProperties = <>
            Name = 'text'
            Type = ptString
            Required = False
            Description = 
              'Text to look for in sender, subject, brand, handler or departmen' +
              't'
            Properties = <>
          end>
        StrictParams = False
        OnExecute = AssistantFilterInbox
      end
      item
        Name = 'show_mail'
        Description = 
          'Select a mail in the dashboard, so the user sees its analysis, r' +
          'eply draft and original.'
        Parameters = <
          item
            ArrayProperties = <>
            Name = 'id'
            Type = ptNumber
            Description = 'Mail id'
            Properties = <>
          end>
        OnExecute = AssistantShowMail
      end
      item
        Name = 'show_page'
        Description = 'Open a page of the dashboard.'
        Parameters = <
          item
            ArrayProperties = <>
            Name = 'page'
            Type = ptEnum
            Description = 'Page to open'
            Properties = <>
          end>
        OnExecute = AssistantShowPage
      end>
    OnBeforeUseTool = AssistantBeforeUseTool
    OnExecuted = AssistantExecuted
  end
end
