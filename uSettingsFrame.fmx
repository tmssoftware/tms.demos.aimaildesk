    object lblSettingsInfo: TLabel
      Align = None
      StyledSettings = [Family]
      TextSettings.Font.Size = 12.000000000000000000
      TextSettings.FontColor = xFF64748B
      Position.X = 28.000000000000000000
      Position.Y = 606.000000000000000000
      TextSettings.VertAlign = Leading
      Size.Width = 496.000000000000000000
      Size.Height = 136.000000000000000000
      Size.PlatformDefault = False
      Text = 'The settings live on the triage server (GarageMailMCP.exe) and are changed through its MCP tools, so an LLM can maintain them too. Secrets never come back from the server: leave a secret field empty to keep its value. A first mailbox login opens in a browser on the server machine.'#13#10''#13#10'Dry run only affects forwarding. Reply drafts are always saved as drafts and never sent: a person reviews and sends them.'
    end
